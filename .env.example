# --- Databáze (Neon) ---
# Dashboard Neonu → Connect → Connection string.
# DATABASE_URL je "Pooled connection" (v hostiteli je "-pooler") a používá ji běžící
# aplikace. Parametr pgbouncer=true je pro Prismu povinný, jinak selže na prepared statements.
DATABASE_URL="postgresql://uzivatel:heslo@ep-neco-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# DIRECT_URL je "Direct connection" (bez "-pooler"). Používá ji jen `prisma db push`;
# přes pooler by migrace schématu neprošla.
DIRECT_URL="postgresql://uzivatel:heslo@ep-neco.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Podpis přihlašovacích cookies ---
# Vygeneruj: openssl rand -base64 32     (npm run setup to udělá za tebe)
AUTH_SECRET=""

# --- Nepovinné ---
# Jen při vlastním hostování: cesta k Chromiu pro generování PDF na serveru.
# Na Vercelu nech prázdné — PDF tam vyrábí prohlížeč přes tiskový dialog.
CHROMIUM_PATH=""

# Naseptavac adres (Mapy.cz). Klic je zdarma a bez karty na developer.mapy.cz.
# Bez nej formular funguje dal, jen se adresa vyplnuje rucne.
MAPY_API_KEY=
