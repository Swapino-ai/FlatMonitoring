// FlatMonitoring — datovy model
// Vse v CZK, castky jako Float (staci pro reporting, ne pro ucetnictvi na halere).

generator client {
  provider        = "prisma-client-js"
  // relationJoins nacte nemovitost i vsechny jeji vazby jednim dotazem pres
  // LATERAL JOIN. Pri latenci pres Atlantik je kazda usetrena cesta ~100 ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Neon: sdruzene pripojeni pres pooler — to pouziva bezici aplikace.
  url       = env("DATABASE_URL")
  // Prime pripojeni — migrace a `prisma db push` pres pooler neprojdou.
  directUrl = env("DIRECT_URL")
}

/// Uzivatele: OWNER = plny pristup, PARTNER = read-only (obchodni partner)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("PARTNER") // OWNER | PARTNER
  createdAt    DateTime @default(now())

  podily PropertyOwner[]
}

/// Spoluvlastnictvi bytu. Podil rozhoduje, kolik z hodnoty, dluhu i najmu
/// se zapocita do portfolia daneho uzivatele — a co zdani ve svem priznani.
model PropertyOwner {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Podil v procentech, 0-100. Soucet pres byt nesmi presahnout 100.
  share Float @default(100)

  note      String?
  createdAt DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([userId])
}

/// Nemovitost — ustredni entita aplikace
model Property {
  id       String  @id @default(cuid())
  name     String // pracovni nazev, napr. "Vinohrady 2+kk"
  street   String
  city     String
  zip      String
  district String? // mestska cast / katastr — klic pro tržní sken
  country  String  @default("CZ")

  /// Druh nemovitosti — viz src/lib/catalogs.ts. Rozhoduje o odpisove skupine
  /// i o tom, jestli ma smysl evidovat dispozici a hledat srovnani na trhu.
  type String @default("BYT")

  disposition String? // 1+kk, 2+1 — u garaze nebo pozemku nedava smysl
  areaM2      Float
  floor       Int?
  hasBalcony  Boolean @default(false)
  hasCellar   Boolean @default(false)
  hasParking  Boolean @default(false)
  buildYear   Int?
  cadastralNo String? // cislo jednotky v KN

  /// Souradnice z naseptavace adres. Diky nim hledame srovnatelne nabidky
  /// podle vzdusne vzdalenosti misto shody nazvu ctvrti — byt na hranici
  /// Vinohrad a Zizkova ma bliz k nabidkam za rohem nez k druhemu konci
  /// "sve" ctvrti.
  latitude    Float?
  longitude   Float?
  /// Kraj ve tvaru pro adresu Sreality, napr. "ustecky-kraj". Zaloha pro male
  /// obce, ktere na Sreality vlastni vypis nemaji (Bohusovice nad Ohri vraci
  /// 404). Okres neexistuje v zadnem tvaru — overeno sondou.
  region      String?

  // --- Porizeni ---
  purchaseDate     DateTime
  purchasePrice    Float // kupni cena jednotky
  acquisitionCosts Float    @default(0) // dan z nabyti, pravnik, provize, znalec
  renovationCosts  Float    @default(0) // technicke zhodnoceni pred pronajmem
  landShareValue   Float    @default(0) // hodnota podilu na pozemku — NEODEPISUJE SE

  // --- Odpisy dle ZDP (§ 30, § 31/32) ---
  depreciationGroup  Int    @default(5) // 5. skupina = 30 let (zdene domy)
  depreciationMethod String @default("STRAIGHT") // STRAIGHT (§31) | ACCELERATED (§32)
  depreciationStart  Int? // prvni rok odpisovani (default: rok porizeni)

  status String @default("RENTED") // RENTED | VACANT | RENOVATION | FOR_SALE | SOLD

  saleDate  DateTime?
  salePrice Float?

  notes String?

  loans         Loan[]
  leases        Lease[]
  transactions  Transaction[]
  services      Service[]
  valuations    Valuation[]
  owners        PropertyOwner[]
  rentEstimates RentEstimate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Hypoteka / uver — "zda vazne dluh na nich"
model Loan {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Druh uveru dle zakona c. 257/2016 Sb. — viz src/lib/catalogs.ts.
  /// Rozhoduje o pravidlech predcasneho splaceni.
  type String @default("HYPOTEKA_NA_BYDLENI")

  lender         String
  contractNo     String?
  principal      Float // puvodni jistina
  interestRate   Float // rocni p.a. v procentech, napr. 4.89
  startDate      DateTime
  termMonths     Int // celkova splatnost
  fixationEnd    DateTime? // konec fixace — hlida se, kvuli refinancovani
  monthlyPayment Float // anuitni splatka
  currentBalance Float // aktualni zustatek (aktualizuje se vypoctem nebo rucne)
  balanceAsOf    DateTime  @default(now())

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Najemni smlouva
model Lease {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantName  String
  tenantEmail String?
  tenantPhone String?

  startDate DateTime
  endDate   DateTime? // null = na dobu neurcitou

  rentMonthly      Float // ciste najemne (zdanitelny prijem dle §9)
  utilitiesMonthly Float @default(0) // zalohy na sluzby — pruchozi polozka, nezdanuje se
  deposit          Float @default(0) // kauce

  indexationClause Boolean @default(false) // inflacni dolozka
  paymentDay       Int     @default(15)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Penezni tok — prijmy i vydaje
model Transaction {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date        DateTime
  amount      Float // kladne = prijem, zaporne = vydaj
  category    String // viz src/lib/categories.ts
  description String?

  /// Danova klasifikace pro §9 DPFO:
  /// INCOME_RENT, EXPENSE_DEDUCTIBLE, EXPENSE_NON_DEDUCTIBLE,
  /// PASS_THROUGH (zalohy na sluzby), CAPITAL (technicke zhodnoceni),
  /// LOAN_PRINCIPAL (splatka jistiny — nedanovy vydaj)
  taxTreatment String @default("EXPENSE_DEDUCTIBLE")

  isRecurring Boolean @default(false)
  documentRef String? // cislo faktury / odkaz na doklad

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sluzba / dodavatel — podklad pro hromadne vyjednavani a zlevnovani
model Service {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type       String // ELECTRICITY | GAS | WATER | HEATING | INTERNET | INSURANCE | SVJ_FEE | MANAGEMENT | WASTE | OTHER
  provider   String
  contractNo String?

  monthlyCost Float
  annualCost  Float? // pokud se plati rocne

  contractStart      DateTime?
  contractEnd        DateTime? // konec zavazku — kdy lze prejit jinam
  noticePeriodMonths Int       @default(0)

  isBundleable Boolean @default(true) // lze zahrnout do hromadne poptavky?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Odhad hodnoty — rucni, znalecky, nebo z mesicniho skenu trhu
model Valuation {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date       DateTime @default(now())
  value      Float // odhadovana trzni hodnota jednotky
  pricePerM2 Float?
  source     String // MANUAL | EXPERT | MARKET_SCAN | INDEX
  confidence String? // LOW | MEDIUM | HIGH
  sampleSize Int? // pocet srovnatelnych nabidek u MARKET_SCAN

  /// Snimek nabidek, ze kterych median vznikl. Ulozeny primo u oceneni,
  /// aby zustalo dolozitelne i pote, co inzeraty z trhu zmizi.
  comparables Json?

  notes String?

  createdAt DateTime @default(now())
}

/// Odhad trzniho najemneho. Vede se zvlast od oceneni, protoze najem se sleduje
/// denne a ma jinou dynamiku nez prodejni cena.
model RentEstimate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  /// Median mesicniho najmu srovnatelnych bytu
  monthlyRent Float
  /// Median najmu za m² — porovnatelne napric velikostmi
  rentPerM2   Float?
  p25         Float?
  p75         Float?

  source     String // MARKET_SCAN | MANUAL
  sampleSize Int?
  confidence String? // LOW | MEDIUM | HIGH

  /// Snimek nabidek, ze kterych median vznikl
  comparables Json?

  notes String?

  createdAt DateTime @default(now())

  @@index([propertyId, date])
}

/// Jeden beh mesicniho skenu trhu
model MarketScan {
  id       String          @id @default(cuid())
  runAt    DateTime        @default(now())
  source   String // SREALITY | BEZREALITKY
  status   String          @default("OK") // OK | PARTIAL | FAILED
  message  String?
  listings MarketListing[]
}

/// Jedna nabidka z trhu (anonymizovany srovnatelny vzorek)
model MarketListing {
  id     String     @id @default(cuid())
  scanId String
  scan   MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  source      String
  externalId  String?
  dealType    String // SALE | RENT
  /// Kategorie nemovitosti (BYT, GARAZ, ...) — bez ni by se do mediánu bytu
  /// dostala garáž podobné plochy.
  category    String  @default("BYT")
  city        String
  /// Kraj, ve kterem se skenovalo. Pro nemovitost bez souradnic je to jediny
  /// zpusob, jak najit srovnani, kdyz se stahoval kraj misto obce — nabidky
  /// pak nesou jina mesta nez ta nemovitost.
  region      String?
  district    String?
  disposition String?
  areaM2      Float?
  price       Float
  pricePerM2  Float?
  url         String?
  latitude    Float?
  longitude   Float?

  scrapedAt DateTime @default(now())

  @@index([city, district, dealType, disposition])
  @@index([category, city, dealType])
}

/// Makro ukazatele pro indexaci a kontext (CNB repo sazba, index cen CSU)
model MarketIndex {
  id     String @id @default(cuid())
  code   String // CZSO_HOUSE_PRICE | CNB_REPO | CPI
  period String // 2026-Q1 nebo 2026-03
  value  Float

  @@unique([code, period])
}

/// Jeden provedeny sken — kdy bezel, nad cim a jak dopadl.
///
/// Bez tohohle zaznamu nejde poznat, jestli nocni sken vubec probehl: prazdna
/// historie odhadu muze znamenat "trh se nehnul" i "uz tyden to pada".
model ScanRun {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// CRON_NAJEM | CRON_TRH | RUCNI
  trigger String
  /// SALE | RENT
  dealType String

  /// Nemovitost muze byt smazana, proto si nazev drzime i zvlast
  propertyId   String?
  propertyName String
  city         String
  category     String

  /// OK | PRAZDNY | SELHALO
  status        String
  listingsFound Int     @default(0)
  okruhKm       Float?
  /// Lidsky vysledek, napr. "odhad 15 200 Kč/měs zapsán"
  result        String?
  /// Text chyby, kdyz sken selhal
  message       String?

  @@index([startedAt])
  @@index([trigger, startedAt])
}
