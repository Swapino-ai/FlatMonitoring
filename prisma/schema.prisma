// FlatMonitoring — datovy model
// Vse v CZK, castky jako Float (staci pro reporting, ne pro ucetnictvi na halere).

generator client {
  provider        = "prisma-client-js"
  // relationJoins nacte nemovitost i vsechny jeji vazby jednim dotazem pres
  // LATERAL JOIN. Pri latenci pres Atlantik je kazda usetrena cesta ~100 ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Neon: sdruzene pripojeni pres pooler — to pouziva bezici aplikace.
  url       = env("DATABASE_URL")
  // Prime pripojeni — migrace a `prisma db push` pres pooler neprojdou.
  directUrl = env("DIRECT_URL")
}

/// Uzivatele: OWNER = plny pristup, PARTNER = read-only (obchodni partner)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("PARTNER") // OWNER | PARTNER
  createdAt    DateTime @default(now())

  /// Kontaktni udaje; pouzivaji se v exportech a podkladech k zdaneni
  street       String?
  city         String?
  zip          String?
  phone        String?
  /// Ucet, kam najemci plati nedoplatek z vyuctovani (kontrolovany tvar)
  account      String?

  podily PropertyOwner[]
}

/// Spoluvlastnictvi bytu. Podil rozhoduje, kolik z hodnoty, dluhu i najmu
/// se zapocita do portfolia daneho uzivatele — a co zdani ve svem priznani.
model PropertyOwner {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Podil v procentech, 0-100. Soucet pres byt nesmi presahnout 100.
  share Float @default(100)

  note      String?
  createdAt DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([userId])
}

/// Nemovitost — ustredni entita aplikace
model Property {
  /// Provozovatel (pronajimatel na smlouvach); null = pouzije se vlastnik s nejvetsim podilem
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  id       String  @id @default(cuid())
  name     String // pracovni nazev, napr. "Vinohrady 2+kk"
  street   String
  city     String
  zip      String
  district String? // mestska cast / katastr — klic pro tržní sken
  country  String  @default("CZ")

  /// Druh nemovitosti — viz src/lib/catalogs.ts. Rozhoduje o odpisove skupine
  /// i o tom, jestli ma smysl evidovat dispozici a hledat srovnani na trhu.
  type String @default("BYT")

  disposition String? // 1+kk, 2+1 — u garaze nebo pozemku nedava smysl
  areaM2      Float
  floor       Int?
  hasBalcony  Boolean @default(false)
  hasCellar   Boolean @default(false)
  hasParking  Boolean @default(false)
  buildYear   Int?
  cadastralNo String? // cislo jednotky v KN

  /// Souradnice z naseptavace adres. Diky nim hledame srovnatelne nabidky
  /// podle vzdusne vzdalenosti misto shody nazvu ctvrti — byt na hranici
  /// Vinohrad a Zizkova ma bliz k nabidkam za rohem nez k druhemu konci
  /// "sve" ctvrti.
  latitude  Float?
  longitude Float?
  /// Kraj ve tvaru pro adresu Sreality, napr. "ustecky-kraj". Zaloha pro male
  /// obce, ktere na Sreality vlastni vypis nemaji (Bohusovice nad Ohri vraci
  /// 404). Okres neexistuje v zadnem tvaru — overeno sondou.
  region    String?

  /// Okruh pro hledani srovnatelnych nabidek v km. Null = automaticky podle
  /// druhu nemovitosti s rozsirovanim, dokud neni dost vzorku. Rucne zadany
  /// okruh se nerozsiruje — kdo ho nastavi, vi proc.
  scanRadiusKm Float?

  /// Obce, ze kterych se nabidky k teto jednotce nepricitaji, oddelene carkou.
  /// Byt v Bohusovicich se nema poměřovat s Roudnici, i kdyz je blizko.
  excludedCities String?

  // --- Porizeni ---
  purchaseDate     DateTime
  purchasePrice    Float // kupni cena jednotky
  acquisitionCosts Float    @default(0) // dan z nabyti, pravnik, provize, znalec
  renovationCosts  Float    @default(0) // technicke zhodnoceni pred pronajmem
  landShareValue   Float    @default(0) // hodnota podilu na pozemku — NEODEPISUJE SE

  // --- Odpisy dle ZDP (§ 30, § 31/32) ---
  depreciationGroup  Int    @default(5) // 5. skupina = 30 let (zdene domy)
  depreciationMethod String @default("STRAIGHT") // STRAIGHT (§31) | ACCELERATED (§32)
  depreciationStart  Int? // prvni rok odpisovani (default: rok porizeni)

  status String @default("RENTED") // RENTED | VACANT | RENOVATION | FOR_SALE | SOLD

  saleDate  DateTime?
  salePrice Float?

  notes String?

  loans         Loan[]
  leases        Lease[]
  transactions  Transaction[]
  services      Service[]
  valuations    Valuation[]
  excluded      ExcludedListing[]
  owners        PropertyOwner[]
  rentEstimates RentEstimate[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cadastre  CadastreRecord?
}

/// Hypoteka / uver — "zda vazne dluh na nich"
model Loan {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Druh uveru dle zakona c. 257/2016 Sb. — viz src/lib/catalogs.ts.
  /// Rozhoduje o pravidlech predcasneho splaceni.
  type String @default("HYPOTEKA_NA_BYDLENI")

  lender         String
  contractNo     String?
  principal      Float // puvodni jistina
  interestRate   Float // rocni p.a. v procentech, napr. 4.89
  startDate      DateTime
  termMonths     Int // celkova splatnost
  fixationEnd    DateTime? // konec fixace — hlida se, kvuli refinancovani
  monthlyPayment Float // anuitni splatka
  currentBalance Float // aktualni zustatek (aktualizuje se vypoctem nebo rucne)
  balanceAsOf    DateTime  @default(now())

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Najemni smlouva
model Lease {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Jednoznacna identita najemce; sloupce tenant* nize jsou jeji zrcadlo pro rychle cteni
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  tenantName   String
  tenantEmail  String?
  tenantPhone  String?
  // Adresa najemce: do smlouvy, k vyuctovani a k dokladum
  tenantStreet String?
  tenantCity   String?
  tenantZip    String?
  // Ucet, kam se posila vratka preplatku z vyuctovani sluzeb
  tenantAccount String?

  startDate DateTime
  endDate   DateTime? // null = na dobu neurcitou

  rentMonthly      Float // ciste najemne (zdanitelny prijem dle §9)
  utilitiesMonthly Float @default(0) // zalohy na sluzby — pruchozi polozka, nezdanuje se
  deposit          Float @default(0) // kauce

  indexationClause Boolean @default(false) // inflacni dolozka

  // Zalohy najemce jsou zamerne jine nez naklady sluzeb (rezerva, zamerne nizsi zaloha...).
  // Aplikace pak rozdil nehlasi jako chybu, ale zapocitava ho a ukazuje.
  advanceIntentional Boolean @default(false)
  advanceNote        String?
  /// Rozpis zaloh po sluzbach [{serviceId, amount}]; null = jen celkova castka. Soucet je utilitiesMonthly.
  advanceItems       Json?
  paymentDay       Int     @default(15)

  isActive Boolean @default(true)
  notes    String?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  advanceChanges LeaseAdvanceChange[]
  readings       SettlementReading[]
  statements     TenantStatement[]
}

/// Penezni tok — prijmy i vydaje
model Transaction {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date        DateTime
  amount      Float // kladne = prijem, zaporne = vydaj
  category    String // viz src/lib/categories.ts
  description String?

  /// Danova klasifikace pro §9 DPFO:
  /// INCOME_RENT, EXPENSE_DEDUCTIBLE, EXPENSE_NON_DEDUCTIBLE,
  /// PASS_THROUGH (zalohy na sluzby), CAPITAL (technicke zhodnoceni),
  /// LOAN_PRINCIPAL (splatka jistiny — nedanovy vydaj)
  taxTreatment String @default("EXPENSE_DEDUCTIBLE")

  isRecurring Boolean @default(false)
  documentRef String? // cislo faktury / odkaz na doklad

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sluzba / dodavatel — podklad pro hromadne vyjednavani a zlevnovani
model Service {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type       String // ELECTRICITY | GAS | WATER | HEATING | INTERNET | INSURANCE | SVJ_FEE | MANAGEMENT | WASTE | OTHER
  provider   String
  contractNo String?

  monthlyCost Float
  annualCost  Float? // pokud se plati rocne

  contractStart      DateTime?
  contractEnd        DateTime? // konec zavazku — kdy lze prejit jinam
  noticePeriodMonths Int       @default(0)

  isBundleable Boolean @default(true) // lze zahrnout do hromadne poptavky?
  notes        String?

  /**
   * Sluzba se preuctovava najemci a kryji ji jeho zalohy. Soucet techto sluzeb
   * je to, co ma najemce mesicne platit; porovnava se se zalohami ve smlouve.
   * Vychozi je false: u drivejsich sluzeb neni znamo, ktere se preuctovavaji.
   */
  chargedToTenant Boolean @default(false)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  costChanges ServiceCostChange[]
  settlements ServiceSettlement[]
}

/// Odhad hodnoty — rucni, znalecky, nebo z mesicniho skenu trhu
model Valuation {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date       DateTime @default(now())
  value      Float // odhadovana trzni hodnota jednotky
  pricePerM2 Float?
  source     String // MANUAL | EXPERT | MARKET_SCAN | INDEX
  confidence String? // LOW | MEDIUM | HIGH
  sampleSize Int? // pocet srovnatelnych nabidek u MARKET_SCAN

  /// Snimek nabidek, ze kterych median vznikl. Ulozeny primo u oceneni,
  /// aby zustalo dolozitelne i pote, co inzeraty z trhu zmizi.
  comparables Json?

  notes String?

  createdAt DateTime @default(now())
}

/// Odhad trzniho najemneho. Vede se zvlast od oceneni, protoze najem se sleduje
/// denne a ma jinou dynamiku nez prodejni cena.
model RentEstimate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  /// Median mesicniho najmu srovnatelnych bytu
  monthlyRent Float
  /// Median najmu za m² — porovnatelne napric velikostmi
  rentPerM2   Float?
  p25         Float?
  p75         Float?

  source     String // MARKET_SCAN | MANUAL
  sampleSize Int?
  confidence String? // LOW | MEDIUM | HIGH

  /// Snimek nabidek, ze kterych median vznikl
  comparables Json?

  notes String?

  createdAt DateTime @default(now())

  @@index([propertyId, date])
}

/// Jeden beh mesicniho skenu trhu
model MarketScan {
  id       String          @id @default(cuid())
  runAt    DateTime        @default(now())
  source   String // SREALITY | BEZREALITKY
  status   String          @default("OK") // OK | PARTIAL | FAILED
  message  String?
  listings MarketListing[]
}

/// Jedna nabidka z trhu (anonymizovany srovnatelny vzorek)
model MarketListing {
  id     String     @id @default(cuid())
  scanId String
  scan   MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  source      String
  externalId  String?
  dealType    String // SALE | RENT
  /// Kategorie nemovitosti (BYT, GARAZ, ...) — bez ni by se do mediánu bytu
  /// dostala garáž podobné plochy.
  category    String  @default("BYT")
  city        String
  /// Kraj, ve kterem se skenovalo. Pro nemovitost bez souradnic je to jediny
  /// zpusob, jak najit srovnani, kdyz se stahoval kraj misto obce — nabidky
  /// pak nesou jina mesta nez ta nemovitost.
  region      String?
  district    String?
  disposition String?
  areaM2      Float?
  price       Float
  pricePerM2  Float?
  url         String?
  latitude    Float?
  longitude   Float?

  scrapedAt DateTime @default(now())

  @@index([city, district, dealType, disposition])
  @@index([category, city, dealType])
}

/// Makro ukazatele pro indexaci a kontext (CNB repo sazba, index cen CSU)
model MarketIndex {
  id     String @id @default(cuid())
  code   String // CZSO_HOUSE_PRICE | CNB_REPO | CPI
  period String // 2026-Q1 nebo 2026-03
  value  Float

  @@unique([code, period])
}

/// Jeden provedeny sken — kdy bezel, nad cim a jak dopadl.
///
/// Bez tohohle zaznamu nejde poznat, jestli nocni sken vubec probehl: prazdna
/// historie odhadu muze znamenat "trh se nehnul" i "uz tyden to pada".
model ScanRun {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// CRON_NAJEM | CRON_TRH | RUCNI
  trigger  String
  /// SALE | RENT
  dealType String

  /// Nemovitost muze byt smazana, proto si nazev drzime i zvlast
  propertyId   String?
  propertyName String
  city         String
  category     String

  /// OK | PRAZDNY | SELHALO
  status        String
  listingsFound Int     @default(0)
  okruhKm       Float?
  /// Lidsky vysledek, napr. "odhad 15 200 Kč/měs zapsán"
  result        String?
  /// Text chyby, kdyz sken selhal
  message       String?

  @@index([startedAt])
  @@index([trigger, startedAt])
}

/// Nabidka, kterou uzivatel z odhadu vyradil.
///
/// Sken bere, co je nejblizsi, ale nejblizsi nemusi byt srovnatelne: byt
/// v Bohusovicich se poměřuje s Roudnici, ktera je drazsi, a odhad to zvedne.
/// Rozhodnout, co do porovnani nepatri, umi jen clovek, ktery to misto zna.
model ExcludedListing {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  source     String
  externalId String
  /// Popis nabidky v dobe vyrazeni — inzerat casem zmizi, ale uzivatel musi
  /// poznat, co vlastne vyradil
  popis      String
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([propertyId, source, externalId])
  @@index([propertyId])
}

/**
 * Udaje z katastru nemovitosti. Drzi se ulozene, protoze API ma kvotu 500
 * volani za obdobi a katastr se meni zridka — ptat se pri kazdem zobrazeni
 * stranky by kvotu snedlo za den.
 */
model CadastreRecord {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  obecKod       Int?
  obecNazev     String?
  castObceNazev String?

  katastralniUzemiKod   Int?
  katastralniUzemiNazev String?

  lvCislo      Int? // cislo listu vlastnictvi stavby
  stavbaId     Int?
  typStavby    String?
  cisloDomovni Int?

  zpusobVyuziti  String?
  zpusobyOchrany String?
  parcely        String? // "st. 684" nebo vic parcel oddelenych carkou
  /**
   * Id prvni parcely — jen pres nej jde odkazat do Nahlizeni, stavba to neumi.
   */
  parcelaId      Int?

  /**
   * Vsechny jednotky v dome — ze kterych si uzivatel vybere tu svou.
   */
  jednotky      Json?
  cisloJednotky String?

  /**
   * Odkaz do Nahlizeni vlozeny rucne. U jednotky si ho aplikace slozi sama
   * z identifikatoru, u stavby ale Nahlizeni pouziva sifrovany token, ktery
   * zvenku vyrobit nejde — proto ho lze jednou vlozit a dal uz jen klikat.
   */
  nahlizeniOdkaz String?

  nactenoKdy  DateTime  @default(now())
  aktualnostK DateTime?

  @@index([propertyId])
}

/**
 * Zmena nakladu sluzby platna od data. Aktualni hodnota zustava i na sluzbe
 * (cte ji zbytek aplikace), historie umoznuje zpetne zjistit, co platilo kdy.
 * Sluzba bez zaznamu ma po cele dobe aktualni hodnotu.
 */
model ServiceCostChange {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  validFrom   DateTime
  monthlyCost Float
  annualCost  Float?
  createdAt   DateTime @default(now())

  @@unique([serviceId, validFrom])
  @@index([serviceId])
}

/**
 * Zmena zaloh ve smlouve platna od data. Stejny princip jako u nakladu sluzeb.
 */
model LeaseAdvanceChange {
  id        String   @id @default(cuid())
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  validFrom DateTime
  amount    Float
  /// Rozpis po sluzbach platny od tohoto dne (null = jen celkova castka)
  items     Json?
  createdAt DateTime @default(now())

  @@unique([leaseId, validFrom])
  @@index([leaseId])
}

/// Vyuctovani sluzby od dodavatele: od-do, skutecny naklad a zalohy, ktere se dodavateli platily.
/// Obdobi nemusi sedet na mesic ani na smlouvu — rozuctovani na najemce se pocita ze dnu.
model ServiceSettlement {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  periodFrom DateTime
  periodTo   DateTime // vcetne posledniho dne

  totalCost        Float // skutecny naklad za obdobi
  supplierAdvances Float @default(0) // zalohy zaplacene dodavateli za obdobi

  splitMode        String  @default("DAYS") // DAYS | READINGS
  readingUnit      String? // m3, kWh, GJ ...
  ownerConsumption Float? // spotreba mimo najemniky (prazdny byt, spolecne)

  invoiceNo String?
  notes     String?
  createdAt DateTime @default(now())

  readings SettlementReading[]

  @@index([serviceId, periodFrom])
}

/// Spotreba najemce za obdobi vyuctovani (odecet pri vymene najemnika).
model SettlementReading {
  id           String            @id @default(cuid())
  settlementId String
  settlement   ServiceSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  leaseId      String
  lease        Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  consumption  Float

  @@unique([settlementId, leaseId])
}

/// Databaze najemniku. Jeden clovek = jeden radek, at ma smluv kolik chce (prodlouzeni,
/// novy byt). Kontaktni udaje se drzi tady; smlouvy je jen odkazuji.
model Tenant {
  id      String @id @default(cuid())
  /// Citelne poradove cislo pro lidi (N-0001)
  cislo   Int    @unique @default(autoincrement())
  name    String
  email   String?
  phone   String?
  street  String?
  city    String?
  zip     String?
  /// Ucet pro vratku preplatku (kontrolovany tvar)
  account String?
  notes   String?

  createdAt DateTime @default(now())
  leases    Lease[]

  @@index([email])
}

/// Druhy sluzeb, ktere jde upravovat (nazev, ikona, zda se obvykle preuctovava najemci).
/// Sluzba na druh odkazuje klicem v Service.type; vychozi druhy se zalozi pri prvnim pouziti.
model ServiceType {
  key              String  @id
  name             String
  icon             String  @default("tri")
  chargedByDefault Boolean @default(false)
  sort             Int     @default(0)
}

/// Propojeni s Google Diskem (jeden zaznam). Soubory se ukladaji jen tam, v databazi je jen odkaz.
/// Pristup je pres OAuth s rozsahem drive.file: aplikace vidi jen to, co sama na Disk nahrala.
model GoogleConnection {
  id           String   @id @default("main")
  email        String?
  refreshToken String
  rootFolderId String
  connectedAt  DateTime @default(now())
}

/// Pamet slozek na Disku: logicka cesta -> id slozky, aby se pri kazdem nahrani nehledalo.
model DriveFolder {
  klic    String @id // napr. "NEM/P:abc123/C:NAJEM/T:xyz"
  driveId String
  nazev   String
}

/// Dokument nahrany na Google Disk. Vazby jsou volne (retezce), at smazani zaznamu nesmaze soubor.
model Dokument {
  id           String   @id @default(cuid())
  driveId      String   @unique
  name         String
  mime         String
  size         Int
  kategorie    String
  propertyId   String?
  tenantId     String?
  leaseId      String?
  serviceId    String?
  settlementId String?
  statementId  String?
  rok          Int?
  note         String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([propertyId, kategorie])
  @@index([tenantId])
  @@index([leaseId])
  @@index([serviceId])
}

/// Vyuctovani sluzeb vydane najemci. Cisla jsou zmrazena v `snapshot`: pozdejsi uprava
/// vyuctovani od dodavatele uz vydany dokument nezmeni. Oprava = storno + nove vyuctovani.
model TenantStatement {
  id         String  @id @default(cuid())
  cislo      String  @unique // VN-2026-0001
  vs         String // variabilni symbol, jen cislice (20260001)
  leaseId    String?
  lease      Lease?  @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  tenantId   String?
  propertyId String

  periodFrom DateTime
  periodTo   DateTime
  /// Zalohy minus naklady: kladne = vratka najemci, zaporne = nedoplatek
  result     Float
  snapshot   Json

  status String @default("VYDANO") // VYDANO | ODESLANO | VYPORADANO | STORNO

  issuedAt     DateTime @default(now())
  issuedById   String?
  sentAt       DateTime?
  sentVia      String? // EMAIL | OSOBNE | POSTA | JINAK
  dueDate      DateTime? // splatnost nedoplatku, resp. termin vraceni preplatku
  settledAt    DateTime?
  settledNote  String?
  stornoAt     DateTime?
  stornoReason String?
  note         String?

  @@index([leaseId, periodFrom])
  @@index([propertyId])
}

/// Provozovatel nemovitosti: strana, ktera je na najemnich smlouvach a vyuctovani jako pronajimatel.
/// Nemusi byt vlastnik (vlastnici jsou v PropertyOwner a vidi sve portfolio); muze to byt firma ci sprava.
model Operator {
  id      String @id @default(cuid())
  name    String
  street  String?
  city    String?
  zip     String?
  ico     String?
  dic     String?
  email   String?
  phone   String?
  /// Ucet, kam najemci placi najem a nedoplatky (kontrolovany tvar)
  account String?
  notes   String?

  createdAt  DateTime   @default(now())
  properties Property[]
}
